{
  "name": "ancient-lens",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "postinstall": "nuxt prepare && node tools/wrangler-ci-shim/link-bin.mjs",
    "sync:items": "node scripts/sync-opendota-items.mjs",
    "sync:heroes": "node scripts/sync-opendota-heroes.mjs",
    "sync:abilities": "node scripts/sync-opendota-abilities.mjs",
    "build": "nuxt build",
    "dev": "nuxt dev --host 0.0.0.0 --port 3000",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --project e2e",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run generate",
    "deploy": "wrangler deploy",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{vue,ts,js,mjs,css,scss,md,json}": "prettier --write",
    "*.{vue,ts,js,mjs}": "eslint --fix"
  },
  "dependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/test-utils": "^4.3.2",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/seo": "^5.3.14",
    "@pinia/nuxt": "^1.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "eslint": "^10.10.0",
    "nuxt": "^4.5.2",
    "nuxt-security": "^2.5.1",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.130",
    "@types/node": "^26.5.0",
    "@types/three": "^0.185.4",
    "@vue/test-utils": "^2.5.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass": "^1.104.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11",
    "wrangler": "file:tools/wrangler-ci-shim"
  }
}
